@import "../../../style/tokens.wxss";
.page{min-height:100vh;background:#F5F6F8;padding:28rpx}.balance-card{background:linear-gradient(135deg,#FF9A3D,#E8730C);color:#fff;border-radius:26rpx;padding:40rpx;display:flex;flex-direction:column}.balance{font-size:58rpx;font-weight:700;margin:18rpx 0}.sub{font-size:23rpx;opacity:.7}.card{background:#fff;border-radius:22rpx;padding:30rpx;margin-top:24rpx}.title{display:block;font-size:30rpx;font-weight:700;color:#E8730C;margin-bottom:20rpx}input{color:#333333}input[disabled]{color:#9CA3AF}button{background:#E8730C!important;color:#fff!important;border-radius:999rpx;margin-top:24rpx}.record{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #F0F0F0}.empty{color:#91877C;font-size:24rpx}.frozen-tip{margin-top:18rpx;background:rgba(255,255,255,.18);border-radius:12rpx;padding:16rpx 20rpx;font-size:23rpx;line-height:1.6}.field-block{margin:24rpx 0}.field-label{display:block;font-size:26rpx;color:#666666;margin-bottom:10rpx}.field-input-box{display:flex;align-items:center;background:#FFFFFF;border:2rpx solid #D1D5DB;border-radius:14rpx;padding:6rpx 10rpx;min-height:80rpx;box-sizing:border-box}.field-prefix{font-size:36rpx;color:#E8730C;font-weight:700;padding:0 20rpx 0 10rpx;flex-shrink:0}.field-input{flex:1;background:transparent;color:#111111;font-size:34rpx;padding:16rpx 10rpx;min-height:56rpx}.field-input.single{background:#FFFFFF;border:2rpx solid #D1D5DB;border-radius:14rpx;padding:20rpx 24rpx;font-size:32rpx;color:#111111;min-height:56rpx;box-sizing:border-box}.full-btn{flex-shrink:0;background:#FFF3E8;color:#E8730C;font-size:24rpx;padding:14rpx 22rpx;border-radius:999rpx;margin-left:8rpx}.tip{font-size:22rpx;color:#91877C;line-height:1.6}.record-left{display:flex;align-items:center;gap:20rpx;flex-shrink:0}.record-status{font-size:22rpx;color:#91877C}.record-hint{font-size:22rpx;color:#E8730C}.record-receive{display:flex;align-items:flex-end;flex-direction:column;gap:10rpx;min-width:0}.receive-btn{height:54rpx;min-width:150rpx;margin:0!important;padding:0 24rpx;font-size:23rpx;line-height:54rpx}.receive-btn[disabled]{opacity:.55}
