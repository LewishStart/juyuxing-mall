<view class="page">
  <view class="balance-card">
    <text>可提现金额</text><text class="balance">¥{{available}}</text><text class="sub">提现处理中 ¥{{pendingAmount}} · 账面余额 ¥{{ledgerBalance}}</text>
    <view class="frozen-tip" wx:if="{{frozenCount > 0}}">冻结中 ¥{{frozenAmount}}（{{frozenCount}}笔）— 买家确认收货后自动转为可提现</view>
  </view>
  <view class="card"><text class="title">申请提现</text>

  <view class="field-block">
    <text class="field-label">提现金额（元）</text>
    <view class="field-input-box">
      <text class="field-prefix">¥</text>
      <input class="field-input" type="digit" value="{{amount}}" bindinput="onAmount" placeholder="请输入金额" placeholder-style="color:#666666;font-size:32rpx;"/>
      <view class="full-btn" bindtap="fullAmount">全部提现</view>
    </view>
  </view>

  <view class="field-block">
    <text class="field-label">收款人姓名</text>
    <input class="field-input single" value="{{name}}" bindinput="onName" placeholder="真实姓名" placeholder-style="color:#666666;font-size:32rpx;"/>
  </view>

  <view class="field-block">
    <text class="field-label">收款账号</text>
    <input class="field-input single" value="{{account}}" bindinput="onAccount" placeholder="微信号 / 支付宝 / 银行卡号" placeholder-style="color:#666666;font-size:32rpx;"/>
  </view>

  <view class="tip">单笔不低于 0.3 元；审核通过后自动转入你的微信零钱（需在微信中确认收款）</view>
  <button bindtap="submit" loading="{{submitting}}">提交申请</button>
</view>
  <view class="card"><text class="title">提现记录</text>
    <view class="record" wx:for="{{records}}" wx:key="_id">
      <view class="record-left"><text>¥{{item.amount / 100}}</text><text class="record-status">{{item.statusText}}</text></view>
      <view class="record-receive" wx:if="{{item.status === 'transferring'}}">
        <text class="record-hint">微信转账已发起，请确认领取</text>
        <button class="receive-btn" data-id="{{item._id}}" bindtap="receiveTransfer" loading="{{receivingId === item._id}}" disabled="{{receivingId !== ''}}">确认收款</button>
      </view>
    </view>
    <text class="empty" wx:if="{{records.length === 0}}">暂无记录</text>
  </view>
</view>
