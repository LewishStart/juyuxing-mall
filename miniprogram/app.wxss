/* 林元元中医生活 - 全局样式 */
@import './style/tokens.wxss';

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: var(--color-text);
  background-color: var(--color-bg);
  font-size: var(--fs-sm);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

/* ====== 通用按钮 ====== */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-bright) 100%);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-pill);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--fs-md);
  font-weight: 500;
  box-shadow: var(--shadow-md);
  transition: all 0.2s;
}
.btn-primary:active { opacity: 0.85; transform: scale(0.98); }
.btn-primary[disabled], .btn-primary.btn-disabled {
  background: var(--color-text-disabled);
  color: #FFFFFF;
  box-shadow: none;
}
.btn-secondary {
  background: var(--color-card);
  color: var(--color-primary-dark);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
  height: 80rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: var(--fs-md);
}
.btn-ghost {
  background: transparent;
  color: var(--color-text-sub);
  border: 2rpx solid var(--color-divider);
  border-radius: var(--radius-pill);
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: var(--fs-sm);
}

/* ====== 卡片 ====== */
.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin: 0 var(--space-md) var(--space-sm);
  box-shadow: var(--shadow-sm);
}

/* ====== 页面容器 ====== */
.page-wrap {
  min-height: 100vh;
  padding-bottom: 30rpx;
}
.page-wrap.with-tabbar { padding-bottom: calc(120rpx + env(safe-area-inset-bottom, 0)); }

/* ====== 分割线 ====== */
.divider { height: 2rpx; background: var(--color-divider); margin: var(--space-md) 0; }

/* ====== 加载状态 ====== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--color-text-sub);
  font-size: var(--fs-sm);
}
.loading-dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--color-primary);
  border-radius: 50%;
  margin: 0 8rpx;
  animation: pulse 1.2s ease-in-out infinite;
}
.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes pulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1.2); }
}

/* ====== 列表行 ====== */
.list-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.list-row:last-child { border-bottom: none; }
.list-label {
  width: 160rpx;
  color: var(--color-text-sub);
  font-size: var(--fs-sm);
  flex-shrink: 0;
}
.list-value {
  flex: 1;
  color: var(--color-text);
  font-size: var(--fs-sm);
}

/* ====== 徽章 ====== */
.badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: var(--color-danger);
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* ====== 输入框统一样式 ====== */
.input-field {
  width: 100%;
  height: 72rpx;
  border: 2rpx solid var(--color-divider);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-md);
  font-size: var(--fs-sm);
  color: var(--color-text);
  background: var(--color-card);
}
.textarea-field {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid var(--color-divider);
  border-radius: var(--radius-sm);
  padding: 20rpx var(--space-md);
  font-size: var(--fs-sm);
  color: var(--color-text);
  background: var(--color-card);
}

/* ====== 底部安全区 ====== */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom, 0); }

/* ====== 旧硬编码类名兼容（保留过渡） ====== */
.btn-disabled {
  background: var(--color-text-disabled);
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--fs-md);
}
