/* 林元元 · 品牌暖橙 v3 — 小程序 tokens（rpx 版） */
/* 方案 B 换肤：2026-09-03，主色 #E8730C，中性背景 #F5F6F8 */
page {
  /* 画布 */
  --color-bg:         #F5F6F8;
  --color-bg-pale:    #EFF1F4;
  --color-bg-soft:    #E9ECF1;
  --color-card:       #FFFFFF;
  --color-card-soft:  #FAFAFA;

  /* 文字 */
  --color-text:        #333333;
  --color-text-sub:    #666666;
  --color-text-muted:  #999999;
  --color-text-faint:  #C6C6C6;
  --color-text-disabled: #DDDDDD;

  /* 主题色：品牌暖橙 */
  --color-primary:      #E8730C;
  --color-primary-soft: #FF9A3D;
  --color-primary-dark: #C25E08;

  /* 强调色：价格红 / 售罄 */
  --color-accent:       #FA5151;
  --color-accent-soft:  #FF8A80;

  /* 辅助：暖橙系 / 草本绿（次要色，保留中医气质） */
  --color-warm:        #E8730C;
  --color-warm-soft:   #FFF2E3;
  --color-leaf:        #8BA888;
  --color-leaf-soft:   #B5C9B0;

  /* 语义色 */
  --color-success:     #04BE02;
  --color-warning:     #FA9D3B;
  --color-danger:      #FA5151;
  --color-info:        #576B95;

  /* 边框 / 分割 */
  --color-border:        #E8E8E8;
  --color-divider:       #F0F0F0;
  --color-divider-strong:#D9D9D9;

  /* 字体 */
  --font-sans:  -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-serif: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif;
  --font-family: var(--font-sans);

  /* 字号（rpx） */
  --fs-xs: 22rpx;
  --fs-sm: 26rpx;
  --fs-md: 30rpx;
  --fs-lg: 34rpx;
  --fs-xl: 40rpx;
  --fs-2xl: 48rpx;
  --fs-3xl: 56rpx;

  /* 间距（rpx） */
  --space-2xs: 4rpx;
  --space-xs:  8rpx;
  --space-sm:  16rpx;
  --space-md:  24rpx;
  --space-lg:  32rpx;
  --space-xl:  48rpx;
  --space-2xl: 64rpx;

  /* 圆角 */
  --radius-xs:  4rpx;
  --radius-sm:  12rpx;
  --radius-md:  20rpx;
  --radius-lg:  28rpx;
  --radius-xl:  40rpx;
  --radius-pill: 999rpx;

  /* 阴影（更柔更克制） */
  --shadow-xs: 0 2rpx 6rpx rgba(0,0,0,.04);
  --shadow-sm: 0 4rpx 16rpx rgba(0,0,0,.06);
  --shadow-md: 0 8rpx 32rpx rgba(0,0,0,.08);
  --shadow-lg: 0 16rpx 48rpx rgba(0,0,0,.12);
  --shadow-float: 0 12rpx 36rpx rgba(232,115,12,.18);

  /* 旧名兼容 —— 平滑迁移期间保留 */
  /* primary-light：浅底角色（选中态/提示条底，需配深橙文字） */
  --color-primary-light:  #FFE3C2;
  /* primary-bright：品牌渐变浅端（与 primary 组成 135deg 渐变，白字） */
  --color-primary-bright: #FF9A3D;
  --color-secondary:      var(--color-leaf);

  /* Approved homepage render palette; scoped consumers only. */
  --color-showcase-primary: #FF4B0A;
  --color-showcase-title: #00594F;
  --color-showcase-sub: #677594;
  --color-showcase-muted: #B7B4C5;
  --color-showcase-bg: #FAF8F5;
}
