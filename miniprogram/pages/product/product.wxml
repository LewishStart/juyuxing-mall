<view class="page-wrap with-bottom-bar">
  <skeleton wx:if="{{loading}}" type="detail" />
  <error-state wx:elif="{{loadError}}" text="{{loadError}}" bind:retry="retry" />

  <block wx:else>
    <!-- 商品图片轮播 -->
    <swiper class="product-swiper" indicator-dots="{{true}}" autoplay="{{false}}" circular="{{images.length > 1}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#E8730C">
      <swiper-item wx:for="{{images}}" wx:key="*this">
        <image class="swiper-image" src="{{item}}" mode="aspectFill" lazy-load="{{true}}" binderror="onSwiperError"></image>
      </swiper-item>
    </swiper>
    <view wx:if="{{images.length === 0}}" class="product-swiper product-swiper-empty">
      <text>暂无图片</text>
    </view>

    <!-- 收藏按钮 -->
    <view class="fav-btn" bindtap="toggleFavorite">
      <text class="fav-icon {{isFavorited ? 'fav-icon-on' : ''}}">{{isFavorited ? '♥' : '♡'}}</text>
    </view>

    <!-- 商品信息 -->
    <view class="product-info-section card">
      <view class="price-area">
        <text class="current-price">¥{{ currentPriceText || product.priceText }}</text>
        <text wx:if="{{product.originalPrice && product.originalPrice > (currentPrice || product.price)}}" class="original-price">¥{{ product.originalPriceText }}</text>
        <text class="sales-count">已售 {{product.sales || 0}} 件</text>
      </view>
      <text class="product-name">{{product.name}}</text>
      <text wx:if="{{product.subtitle}}" class="product-subtitle">{{product.subtitle}}</text>
    </view>

    <!-- 规格 / 数量 -->
    <view class="spec-section card" bindtap="openSpecPicker">
      <view class="spec-row">
        <text class="spec-label">已选</text>
        <text class="spec-value">{{specName || '默认规格'}} × {{quantity}}</text>
        <text class="spec-arrow">›</text>
      </view>
    </view>

    <!-- 商品详情 -->
    <view class="detail-section card">
      <view class="detail-header">
        <text class="detail-title">商品详情</text>
      </view>
      <view class="detail-content">
        <rich-text nodes="{{product.description || '详情加载中...'}}" wx:if="{{product.description}}"></rich-text>
        <text wx:else class="detail-empty">暂无详情</text>
      </view>
    </view>

    <!-- 品牌卡片 -->
    <view class="brand-card card">
      <text class="brand-card-title">林元元</text>
      <text class="brand-card-text">源于草本，温润日常。每一份产品都来自对自然的敬畏与热爱。</text>
    </view>
  </block>

  <!-- 规格弹层 -->
  <spec-picker
    show="{{showSpecPicker}}"
    goods="{{product}}"
    bind:close="onSpecClose"
    bind:confirm="onSpecConfirm"
    bind:addcart="onSpecAddCart"
  />

  <!-- 底部操作栏 -->
  <view wx:if="{{product}}" class="bottom-actions safe-bottom">
    <view class="action-left">
      <navigator url="/pages/index/index" open-type="switchTab" class="action-item">
        <image class="action-icon-img" src="/images/icons/home.png" mode="aspectFit"></image>
        <text class="action-text">首页</text>
      </navigator>
      <navigator url="/pages/cart/cart" open-type="switchTab" class="action-item">
        <image class="action-icon-img" src="/images/icons/cart.png" mode="aspectFit"></image>
        <text class="action-text">购物车</text>
      </navigator>
      <navigator url="/pages/chat/chat" class="action-item">
        <image class="action-icon-img" src="/images/icons/chat.png" mode="aspectFit"></image>
        <text class="action-text">客服</text>
      </navigator>
    </view>
    <view class="action-right">
      <button class="btn-add-cart" bindtap="openSpecPicker">加入购物车</button>
      <button class="btn-buy-now" bindtap="openSpecPicker">立即购买</button>
    </view>
  </view>
</view>
