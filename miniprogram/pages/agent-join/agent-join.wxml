<view class="page-wrap">
  <view class="banner card">
    <image class="banner-icon-img" src="/images/icons/star.png" mode="aspectFit"></image>
    <text class="banner-title">成为林元元代理</text>
    <text class="banner-desc">分享好物 · 收获一份事业</text>
  </view>

  <view class="benefits card">
    <text class="section-title">代理权益</text>
    <view class="benefit-item">
      <text class="benefit-icon">🔗</text>
      <text class="benefit-label">永久用户绑定</text>
    </view>
    <view class="benefit-item">
      <text class="benefit-icon">📈</text>
      <text class="benefit-label">阶梯返利成长</text>
    </view>
    <view class="benefit-item">
      <text class="benefit-icon">💰</text>
      <text class="benefit-label">快速结算到账</text>
    </view>
    <view class="benefit-item">
      <text class="benefit-icon">🎯</text>
      <text class="benefit-label">专属客服支持</text>
    </view>
  </view>

  <view class="how-it-works card">
    <text class="section-title">如何赚钱</text>
    <view class="step-item">
      <text class="step-num">1</text>
      <view class="step-content">
        <text class="step-title">分享商品</text>
        <text class="step-desc">将商品链接分享给好友或朋友圈</text>
      </view>
    </view>
    <view class="step-item">
      <text class="step-num">2</text>
      <view class="step-content">
        <text class="step-title">好友下单</text>
        <text class="step-desc">用户通过你的链接进入并完成购买</text>
      </view>
    </view>
    <view class="step-item">
      <text class="step-num">3</text>
      <view class="step-content">
        <text class="step-title">获得返利</text>
        <text class="step-desc">订单完成后，返利自动结算到你的余额</text>
      </view>
    </view>
  </view>

  <view class="form card">
    <view class="form-row">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入真实姓名" value="{{name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" value="{{phone}}" data-field="phone" bindinput="onInput" maxlength="11" />
    </view>
    <view class="form-row form-row-textarea">
      <text class="form-label">申请理由</text>
      <textarea class="form-textarea" placeholder="请简单说明您的优势、资源或对品牌的理解" value="{{reason}}" data-field="reason" bindinput="onInput" maxlength="300" />
    </view>
  </view>

  <view class="submit-wrap safe-bottom">
    <button class="submit-btn" bindtap="submit" disabled="{{submitting}}">{{submitting ? '提交中...' : '提交申请'}}</button>
  </view>
</view>
