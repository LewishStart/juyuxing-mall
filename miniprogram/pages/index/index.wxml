<view class="page-wrap with-tabbar home-wrap">
  <!-- 顶部渐变区：品牌 + 搜索 + 双入口 -->
  <view class="home-top">
    <view class="home-brand-row">
      <text class="home-brand-name">林元元</text>
      <text class="home-brand-tag">中医生活 · 自然疗愈</text>
    </view>
    <view class="search-bar search-bar-icon-only" bindtap="goSearch" hover-class="search-bar-hover">
      <image class="search-icon" src="/images/icons/search.png" mode="aspectFit"></image>
    </view>
    <view class="promo-row">
      <view class="promo-card" bindtap="goCouponCenter" hover-class="promo-card-hover">
        <image class="promo-icon" src="/images/icons/ticket.png" mode="aspectFit"></image>
        <view class="promo-text">
          <text class="promo-title">领券中心</text>
          <text class="promo-desc">{{couponDesc}}</text>
        </view>
      </view>
      <view class="promo-card" bindtap="showPromotionRules" hover-class="promo-card-hover">
        <image class="promo-icon" src="/images/icons/sale.png" mode="aspectFit"></image>
        <view class="promo-text">
          <text class="promo-title">全场满减</text>
          <text class="promo-desc">{{promotionDesc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 轮播图 -->
  <view class="banner-section" wx:if="{{banners.length > 0}}">
    <swiper class="banner-swiper" autoplay="{{true}}" interval="{{4000}}" duration="{{500}}" circular="{{true}}" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#E8730C">
      <swiper-item wx:for="{{banners}}" wx:key="_id">
        <view class="banner-item" data-link="{{item.linkUrl}}" bindtap="onBannerTap">
          <image class="banner-image" src="{{item.imageUrl}}" mode="aspectFit" data-index="{{index}}" binderror="onBannerImageError"></image>
          <text class="banner-title" wx:if="{{item.title}}">{{item.title}}</text>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 产品展示区 -->
  <view class="product-section" id="product">
    <view class="section-header">
      <text class="section-title">热卖单品</text>
      <text class="section-subtitle">Products</text>
    </view>

    <block wx:if="{{loading}}">
      <skeleton type="card" count="{{3}}" />
    </block>

    <error-state wx:elif="{{loadError}}" text="{{loadError}}" bind:retry="retry" />

    <block wx:elif="{{products.length === 0}}">
      <empty-state icon="/images/icons/leaf.png" text="商品即将上架" />
    </block>

    <block wx:else>
      <view class="product-grid {{products[0].name === '小紫瓶' ? 'product-grid-reference' : ''}}">
        <goods-card
          wx:for="{{products}}"
          wx:key="_id"
          wx:for-item="p"
          goods="{{p}}"
          mode="grid"
          wide="{{true}}"
          show-badge="{{true}}"
          badge-text="{{index === 0 ? '纯草本配方更安心' : (index === 1 ? '热销推荐' : '安心好物')}}"
          detail-text="{{index === 0 ? '用于全年龄段皮肤不适的舒缓' : ''}}"
          action-text="立即购买"
          display-image="{{p.name === '小紫瓶' ? '/images/product-xiaoziping-card.png' : ''}}"
          dynamic="{{index === 0}}"
          reference-art="{{p.name === '小紫瓶'}}"
          bind:click="onGoodsClick"
          bind:action="onGoodsAction"
        />
      </view>

      <view class="loading-more" wx:if="{{loadingMore}}">
        <view class="loading-dot"></view><view class="loading-dot"></view><view class="loading-dot"></view>
      </view>
      <view class="loading-end" wx:elif="{{!hasMore && products.length > 0}}">- 已经到底了 -</view>
    </block>
  </view>

  <!-- 品牌故事 -->
  <view class="story-section">
    <view class="section-header">
      <text class="section-title">品牌故事</text>
      <text class="section-subtitle">About</text>
    </view>
    <view class="story-content card">
      <view class="story-quote-mark">"</view>
      <text class="story-text">
        「林元元」专注中医草本日常养护。深耕中医临床多年的医学博士，以纯天然草本配方，做全家安心的肌肤日常防护。
      </text>
      <text class="story-text">
        拒绝激素、拒绝刺激性化学药品添加——温和有度、起效有据、安全终身。
      </text>
      <navigator url="/pages/about/about" class="story-link">了解更多 →</navigator>
    </view>
  </view>

</view>
