<view class="privacy-mask" wx:if="{{show}}">
  <view class="privacy-card">
    <view class="privacy-title">隐私授权</view>
    <view class="privacy-content">
      感谢使用林元元中医生活。我们高度重视您的个人信息保护，使用前请阅读并同意
      <text class="privacy-link" bindtap="openContract">《隐私保护指引》</text>，
      我们将依据指引收集您的微信昵称、头像用于完善个人资料。
    </view>
    <view class="privacy-actions">
      <button class="privacy-btn privacy-btn-ghost" bindtap="onDisagree">拒绝</button>
      <button class="privacy-btn privacy-btn-primary" bindtap="onAgree">同意并继续</button>
    </view>
  </view>
</view>
